#ifndef READTHREAD_H
#define READTHREAD_H

#include <QObject>
#include <QTimer>
#include <QThread>
#include "videodecode.h"

class VideoDecode;
class PlayImage;
class ReadThread:public QThread
{
    Q_OBJECT
    enum PlayState      // 视频播放状态
    {
        play,
        end
    };
public:
    ReadThread();
    ~ReadThread();

    void open(const QString strUrl); //打开视频
    void pause(bool bFlag);
    void close();
    const QString& url();

protected:
    void run() override;


private:
    VideoDecode* m_videoDecode = nullptr;       // 视频解码类

    QString m_strUrl;
    bool    m_bPlay = false;  //播放控制
    bool    m_bPause = false; //暂停控制
    QElapsedTimer m_etime1;                     // 控制视频播放速度（更精确，但不支持视频后退）
    QTime         m_etime2;                     // 控制视频播放速度（支持视频后退）
};

#endif // READTHREAD_H
